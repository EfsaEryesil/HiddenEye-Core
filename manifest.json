{
  "manifest_version": 3,
  "name": "HiddenEye Core",
  "version": "1.3",
  "description": "Advanced OSINT, WAF, Cookie & Vulnerability Scanner",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://cve.circl.lu/*",
    "https://registry.npmjs.org/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  }
}